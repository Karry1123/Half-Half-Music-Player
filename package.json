{
  "name": "half-half-music-player",
  "version": "0.7.0",
  "private": true,
  "description": "Half&Half Music Player：双人 P2P 同步播放（React + Vite + Zustand + WebRTC）",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "node node_modules/vite/bin/vite.js build && node scripts/bundle-dashboard.mjs",
    "start": "node server/index.js",
    "music": "npm --prefix music-service start",
    "test": "node --test \"tests/*.test.mjs\"",
    "nat-check": "node scripts/nat-check.mjs",
    "build:deploy": "npm run build && node scripts/write-app-config.mjs",
    "build:android": "npm run build:deploy && node scripts/prepare-android-web.mjs",
    "cap:sync": "npm run build:android && node node_modules/@capacitor/cli/bin/capacitor sync android",
    "android:debug": "npm run cap:sync && node scripts/gradle.mjs assembleDebug"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor-community/file-opener": "^8.0.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/preferences": "^8.0.1",
    "@capawesome-team/capacitor-android-foreground-service": "^8.1.0",
    "htm": "^3.1.1",
    "jszip": "^3.10.2",
    "lucide-react": "^0.460.0",
    "peerjs": "^1.5.4",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@vitejs/plugin-react": "^4.5.0",
    "node-turn": "^0.0.6",
    "qrcode-terminal": "^0.12.0",
    "tailwindcss": "^3.4.17",
    "vite": "^6.3.5"
  }
}
