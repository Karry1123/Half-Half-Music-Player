{
  "name": "half-half-music-player",
  "version": "0.1.0",
  "private": true,
  "description": "Half&Half Music Player：双人 P2P 同步播放（React + Vite + Zustand + WebRTC）",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "node node_modules/vite/bin/vite.js build",
    "start": "node server/index.js",
    "music": "npm --prefix music-service start",
    "test": "node --test \"tests/*.test.mjs\"",
    "nat-check": "node scripts/nat-check.mjs",
    "build:deploy": "node node_modules/vite/bin/vite.js build && node scripts/write-app-config.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.0",
    "node-turn": "^0.0.6",
    "qrcode-terminal": "^0.12.0",
    "vite": "^6.3.5"
  }
}
